#!/usr/bin/env sh
# Launch the checkout's managed environment without installing or downloading.
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
pixi_bin=$repo_dir/.pixi/bin/pixi
if [ ! -x "$pixi_bin" ] || [ ! -x "$repo_dir/.pixi/envs/default/bin/python" ]; then
    printf 'The managed ROAR runtime is missing. Run %s/bin/setup_roar.sh first.\n' "$repo_dir" >&2
    exit 1
fi

caller_dir=$(pwd)
unset VIRTUAL_ENV PYTHONHOME PYTHONPATH LD_LIBRARY_PATH LD_PRELOAD
unset QT_PLUGIN_PATH QT_QPA_PLATFORM_PLUGIN_PATH
unset ROAR_ALIGN_PYTHON ROAR_ALIGN_PDK_FIXED ROAR_MANAGED_RUNTIME
export ROAR_HOME="$repo_dir" PYTHONNOUSERSITE=1

# Pixi runs commands in the workspace; the helper restores the caller's cwd so
# relative design paths retain their meaning. Arguments are forwarded literally.
exec "$pixi_bin" run --no-config --manifest-path "$repo_dir/pyproject.toml" \
    --environment default --offline --locked --no-install --executable \
    python "$repo_dir/bin/configure_runtime.py" --launch --cwd "$caller_dir" -- "$@"
